  "name": "AI CRM Update",
  "nodes": [
    {
      "parameters": {
        "content": "## AI CRM Update\n\n1. Manual Trigger → sample lead\n2. Gemini analyzes the lead → structured JSON\n3. Merge lead + analysis into a CRM record\n4. Append record to the \"AI CRM Portfolio\" Google Sheet\n5. HOT leads → urgent Gmail; others → standard Gmail\n6. Completion node confirms each stage"
      },
