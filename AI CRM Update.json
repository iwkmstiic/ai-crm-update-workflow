    {
      "parameters": {
        "promptType": "define",
        "text": "=You are an expert B2B sales analyst. Analyze the following inbound sales lead and return ONLY structured JSON.\n\nLead Name: {{ $json.leadName }}\nCompany: {{ $json.company }}\nEmail: {{ $json.email }}\nPhone: {{ $json.phone }}\nJob Title: {{ $json.jobTitle }}\nInquiry Message: {{ $json.inquiryMessage }}\n\nAssess the lead and produce:\n- leadQuality: exactly one of Hot, Warm, or Cold\n- estimatedDealValue: a realistic estimated deal value (currency string)\n- purchaseIntent: High, Medium, or Low\n- recommendedNextAction: the single best next step for the sales rep\n- leadSummary: a concise 1-2 sentence summary of the opportunity\n- salesPriority: a priority label (e.g. P1 - Urgent, P2 - High, P3 - Standard)\n- suggestedFollowUpEmail: a short, personalized follow-up email body\n- confidenceScore: an integer from 0 to 100 reflecting your confidence\n\nBase HOT ratings on strong buying signals such as approved budget, decision authority, and a short timeline.",
        "hasOutputParser": true,
        "batching": {}
      },
      "id": "d0f93818-e0e0-42de-85c9-1160f047b756",
      "name": "Analyze Lead (Gemini)",
